node_modules/
dist/
coverage/
# Agent worktrees живут внутри репозитория (.worktrees/<ticket>-*):
# без игнора их содержимое попадает в `git status` и в прогоны линтера/форматтера.
.worktrees/
*.log
.env
.env.*
!.env.example
.mise.local.toml
# `.opencode/` — локальное состояние агента (сессии, кэш), но проектные
# артефакты версионируются: MCP-конфигурация `.opencode/opencode.json` (#63)
# и вендоренные скиллы `.opencode/skills/` — они должны быть доступны
# агенту на свежем CI-раннере без глобальной установки.
.opencode/*
!.opencode/opencode.json
!.opencode/skills/
.idea/
*.tsbuildinfo
# Playwright artifacts (см. тикет #34 → Wave C карты #26):
# `playwright-report/` — HTML-отчёт; `test-results/` — JUnit/xUnit и per-test;
# `blob-report/` — внутренний кэш trace'ов для `trace: "on-first-retry"`.
playwright-report/
test-results/
blob-report/
