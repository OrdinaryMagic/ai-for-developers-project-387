{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "railway-mcp": {
        "type": "remote",
        "url": "https://mcp.railway.com"
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@latest", "mcp"],
        "disabled": false
      }
    }
  },
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:LITELLM_URL}"
      },
      "env": ["LITELLM_KEY"],
      "models": {
        "MiniMax-M3": {
          "name": "MiniMax-M3"
        },
        "MiniMax-M3.1-Flash": {
          "name": "MiniMax-M3.1-Flash"
        }
      }
    }
  }
}
